{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "api",
      "type": "shell",
      "command": "php artisan serve",
      "options": {
        "cwd": "${workspaceFolder}/api_file_manager"
      },
      "problemMatcher": []
    },
    {
      "label": "web",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/web_file_manager"
      },
      "problemMatcher": []
    },
    {
      "label": "start-all",
      "dependsOn": ["api", "web"],
      "dependsOrder": "parallel"
    }
  ]
}
